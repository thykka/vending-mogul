{
  "name": "Vend",
  "version": "1.0.0",
  "description": "Idle vending machine game",
  "type": "module",
  "source": "src/index.html",
  "targets": {
    "default": {
      "includeNodeModules": true
    }
  },
  "scripts": {
    "start": "rm -rf .parcel-cache && npx parcel src/index.html",
    "prebuild": "npm run lint",
    "lint": "eslint . --ext .ts --ext .mts --ext .tsx",
    "prettier": "prettier --config .prettierrc --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "types": "tsc --noEmit",
    "check": "npm run types && npm run lint && npm run test"
  },
  "author": "Moses Holmström",
  "devDependencies": {
    "@parcel/validator-typescript": "^2.16.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.13.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.5.0",
    "jest": "^29.7.0",
    "parcel": "^2.12.0",
    "prettier": "^3.3.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5",
    "typescript-plugin-css-modules": "^5.2.0"
  },
  "dependencies": {
    "@jakeklassen/ecs": "^4.0.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tslib": "~2.6"
  }
}
